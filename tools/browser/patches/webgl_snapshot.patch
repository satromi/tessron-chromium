+// With no compositor to take the canvas's layer, the embedder may give the
+// snapshot of what the page drew as an image of a shared image of the GPU
+// process, copied there from the drawing buffer's colour buffer, which the
+// page's raster draws there without reading it back. Given the drawing
+// buffer, the buffer to copy and the context's alpha type, it returns null
+// when it cannot, and the snapshot is read back as before.
+MODULES_EXPORT scoped_refptr<StaticBitmapImage> (*g_webgl_gpu_snapshot)(
+    DrawingBuffer* drawing_buffer,
+    SourceDrawingBuffer source_buffer,
+    SkAlphaType alpha_type) = nullptr;
+
 void WebGLRenderingContextBase::MarkContextChanged(
     ContentChangeType change_type,
     CanvasPerformanceMonitor::DrawType draw_type) {
@@ -1697,6 +1708,16 @@
   if (!canvas())
     return;
 
+  // With no compositor to take the canvas's layer, the page's paint draws
+  // the canvas into the page's record, from the embedder's snapshot or from
+  // one read back: the first change after the frame it last drew (the
+  // snapshot resolves the drawing buffer) is a change of the page's paint,
+  // which is otherwise left to the layer (a composited canvas skips its
+  // paint invalidation).
+  if (LayoutObject* layout_object = canvas()->GetLayoutObject()) {
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+
   if (!marked_canvas_dirty_) {
     marked_canvas_dirty_ = true;
     if (auto* cc_layer = CcLayer())
@@ -2068,6 +2089,27 @@
