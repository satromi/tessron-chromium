 class SkPngNormalDecoder : public SkPngCodec {
+    // The one frame of a still image described, as the decoders that
+    // read animations describe theirs: the image decoder of the engine
+    // takes its frame's place, timing and blending from here.
+public:
+    bool onGetFrameInfo(int index, FrameInfo* info) const override {
+        if (index != 0) {
+            return false;
+        }
+        if (info) {
+            info->fRequiredFrame = SkCodec::kNoFrame;
+            info->fDuration = 0;
+            info->fFullyReceived = true;
+            info->fAlphaType = this->getInfo().alphaType();
+            info->fHasAlphaWithinBounds = info->fAlphaType != kOpaque_SkAlphaType;
+            info->fDisposalMethod = SkCodecAnimation::DisposalMethod::kKeep;
+            info->fBlend = SkCodecAnimation::Blend::kSrcOver;
+            info->fFrameRect = SkIRect::MakeSize(this->dimensions());
+        }
+        return true;
+    }
+
 public:
     SkPngNormalDecoder(SkEncodedInfo&& info,
                        std::unique_ptr<SkStream> stream,
