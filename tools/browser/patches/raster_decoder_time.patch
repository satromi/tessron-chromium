+// What the raster's commands took in this process, for the embedder's
+// console: the rasters ended, the microseconds of their records played
+// and of their flushes; the readbacks, the waits for the drawing to
+// finish before them and their copies.
+std::atomic<int64_t> g_raster_work[6];
+
+// What the readbacks were, for the same console: the readbacks, their
+// pixels, the microseconds of glReadPixels in them (counted by the
+// embedder's wrapper of the GL's function while g_in_readback is set),
+// those whose source is BGRA and those whose destination is BGRA.
+std::atomic<int64_t> g_readback_work[5];
+thread_local bool g_in_readback = false;
+
+namespace {
+
+// Adds the microseconds of its scope to a count of g_raster_work.
+class ScopedWorkTime {
+ public:
+  explicit ScopedWorkTime(int which)
+      : which_(which), start_(base::TimeTicks::Now()) {}
+  ~ScopedWorkTime() {
+    g_raster_work[which_] +=
+        (base::TimeTicks::Now() - start_).InMicroseconds();
+  }
+
+ private:
+  const int which_;
+  const base::TimeTicks start_;
+};
+
+}  // namespace
