 void V8ContextSnapshotImpl::InstallInterfaceTemplates(v8::Isolate* isolate) {
   if (!IsUsingContextSnapshot()) {
+    // The main thread's isolate, set up before any context: its main world's
+    // templates of the snapshot's types are made now with every runtime
+    // feature off, and the features are put back as they were.
+    if (!IsMainThread() || g_emulating_snapshot) {
+      return;
+    }
+    v8::HandleScope handle_scope(isolate);
+    const DOMWrapperWorld& world = DOMWrapperWorld::MainWorld(isolate);
+    RuntimeEnabledFeatures::Backup features;
+    RuntimeEnabledFeatures::SetStableFeaturesEnabled(false);
+    RuntimeEnabledFeatures::SetExperimentalFeaturesEnabled(false);
+    RuntimeEnabledFeatures::SetTestFeaturesEnabled(false);
+    for (const auto& type_info : type_info_table) {
+      std::ignore = type_info.wrapper_type_info->GetV8ClassTemplate(isolate,
+                                                                    world);
+    }
+    features.Restore();
+    g_emulating_snapshot = true;
     return;
   }
 
