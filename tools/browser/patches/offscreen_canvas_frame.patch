+
+// The frames of an OffscreenCanvas for its placeholder canvas, kept by the
+// placeholder's id (html_canvas_element.cc): put from the canvas's thread,
+// shown on the page's thread.
+void PortPlaceholderFramePut(DOMNodeId id, sk_sp<SkImage> image);
+void PortPlaceholderFrameShow(DOMNodeId id);
+
+// There is no compositor to take the canvas's resources (the shared images
+// of a GPU process, or the software compositor's), so the placeholder is
+// given what the context shows as pixels, at each frame: the drawing buffer
+// read back for WebGL (afresh each time: the snapshot WebGL keeps for a
+// canvas with no resource provider is made once and kept), and then taken
+// as composited, as a frame given to a compositor is, so that a drawing
+// buffer that is not preserved is cleared before the next frame's drawing;
+// the current texture's pixels for WebGPU; the context's image otherwise.
+// The page's thread is told, and paints it with the page.
+static bool PortPushSnapshot(OffscreenCanvas* canvas) {
+  CanvasRenderingContext* context = canvas->RenderingContext();
+  if (!context || canvas->Size().IsEmpty() || !canvas->HasPlaceholderCanvas()) {
+    return false;
+  }
+  scoped_refptr<StaticBitmapImage> image =
+      context->IsWebGL() ? context->GetRGBAUnacceleratedStaticBitmapImage(kBackBuffer)
+                         : context->GetImage();
+  if (!image) {
+    return false;
+  }
+  sk_sp<SkImage> sk = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk) {
+    return false;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(sk->imageInfo().makeColorType(kN32_SkColorType)) ||
+      !sk->readPixels(bitmap.pixmap(), 0, 0)) {
+    return false;
+  }
+  bitmap.setImmutable();
+  const DOMNodeId id = canvas->PlaceholderCanvasId();
+  PortPlaceholderFramePut(id, bitmap.asImage());
+  if (context->IsWebGL()) {
+    context->MarkLayerComposited();
+  }
+  if (IsMainThread()) {
+    PortPlaceholderFrameShow(id);
+  } else if (auto* top = canvas->GetTopExecutionContext()) {
+    if (auto runner = top->GetAgentGroupSchedulerCompositorTaskRunner()) {
+      PostCrossThreadTask(*runner, FROM_HERE,
+                          CrossThreadBindOnce(&PortPlaceholderFrameShow, id));
+    }
+  }
+  return true;
+}
