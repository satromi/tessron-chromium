+// An embedder whose frames have no widget (TessronOS) keeps the monitor of
+// the animation frames itself: the monitor of a frame's page, or null.
+CORE_EXPORT AnimationFrameTimingMonitor* (*g_frame_timing_monitor_hook)(
+    LocalFrame&) = nullptr;
+
 void LocalFrame::OnTaskCompleted(base::TimeTicks start_time,
                                  base::TimeTicks end_time) {
   if (FrameWidget* widget = GetWidgetForLocalRoot()) {
     widget->OnTaskCompletedForFrame(start_time, end_time, this);
+  } else if (g_frame_timing_monitor_hook) {
+    if (AnimationFrameTimingMonitor* monitor =
+            g_frame_timing_monitor_hook(*this)) {
+      monitor->OnMainThreadTaskCompleted(start_time, end_time, this);
+    }
   }
 }
 
