 namespace {
 
+// The last frame of each placeholder canvas's OffscreenCanvas, by the
+// placeholder's id (offscreen_canvas.cc, PortPushSnapshot)
+base::Lock& PortFramesLock() {
+  static base::Lock* lock = new base::Lock();
+  return *lock;
+}
+
+HashMap<DOMNodeId, sk_sp<SkImage>>& PortFrames() {
+  static auto* frames = new HashMap<DOMNodeId, sk_sp<SkImage>>();
+  return *frames;
+}
+
+sk_sp<SkImage> PortPlaceholderFrame(DOMNodeId id) {
+  base::AutoLock locker(PortFramesLock());
+  auto it = PortFrames().find(id);
+  return it == PortFrames().end() ? nullptr : it->value;
+}
+
+}  // namespace
+
+void PortPlaceholderFramePut(DOMNodeId id, sk_sp<SkImage> image) {
+  base::AutoLock locker(PortFramesLock());
+  PortFrames().Set(id, std::move(image));
+}
+
+// A new frame came for the placeholder: it is painted again with the page
+void PortPlaceholderFrameShow(DOMNodeId id) {
+  OffscreenCanvasPlaceholder* placeholder =
+      OffscreenCanvasPlaceholder::GetPlaceholderCanvasById(id);
+  if (!placeholder) {
+    return;
+  }
+  auto* canvas = static_cast<HTMLCanvasElement*>(placeholder);
+  if (LayoutObject* layout_object = canvas->GetLayoutObject()) {
+    layout_object->SetShouldDoFullPaintInvalidation();
+  }
+}
