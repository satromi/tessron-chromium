+// The embedder may keep the pixels of a canvas on a GPU. When these are set,
+// a provider asks for a surface there when it is made (the embedder says
+// which canvases it takes: those of its main thread, large enough), and a
+// provider that got one plays its records into it, writes pixels into it
+// and takes snapshots of it there; the snapshot is an image backed by a
+// texture of the embedder's, read back when its pixels are asked for. The
+// provider's own surface is then a pixel, kept for IsValid().
+PLATFORM_EXPORT void* (*g_canvas_2d_gpu_make)(int width,
+                                              int height,
+                                              SkColorType ct,
+                                              SkAlphaType at,
+                                              sk_sp<SkColorSpace> cs,
+                                              const SkSurfaceProps& props) =
+    nullptr;
+PLATFORM_EXPORT void (*g_canvas_2d_gpu_free)(void* surface) = nullptr;
+PLATFORM_EXPORT void (*g_canvas_2d_gpu_raster)(
+    void* surface,
+    cc::PaintRecord record,
+    cc::ImageProvider* images,
+    cc::PlaybackCallbacks::CustomDataRasterCallback callback) = nullptr;
+PLATFORM_EXPORT bool (*g_canvas_2d_gpu_write)(void* surface,
+                                              const SkImageInfo& info,
+                                              const void* pixels,
+                                              size_t row_bytes,
+                                              int x,
+                                              int y) = nullptr;
+PLATFORM_EXPORT cc::PaintImage (*g_canvas_2d_gpu_snapshot)(
+    void* surface,
+    cc::PaintImage::Id id,
+    const gfx::HDRMetadata& hdr) = nullptr;
+
+namespace {
+
+// The embedder's surfaces of the providers that have one
+base::Lock& GpuSurfacesLock() {
+  static base::Lock* lock = new base::Lock();
+  return *lock;
+}
+
+std::map<const Canvas2DBitmapProvider*, void*>& GpuSurfaces() {
+  static auto* surfaces = new std::map<const Canvas2DBitmapProvider*, void*>();
+  return *surfaces;
+}
+
+void* GpuSurfaceOf(const Canvas2DBitmapProvider* provider) {
+  base::AutoLock lock(GpuSurfacesLock());
+  auto it = GpuSurfaces().find(provider);
+  return it == GpuSurfaces().end() ? nullptr : it->second;
+}
